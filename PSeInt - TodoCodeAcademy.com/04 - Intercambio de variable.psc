Algoritmo sin_titulo
	
	Definir num1, num2, aux Como Entero
	num1 = 20
	num2 = 35
	
	Escribir "El valor del primer número es: ", num1
	Escribir "El valor del segundo número es: ", num2
	
	aux = num1
	num1 = num2
	num2 = aux
	
	Escribir "El valor del primer número después del intercambio es: ", num1
	Escribir "El valor del segundo número después del intercambio es: ", num2
	
	
	
FinAlgoritmo
